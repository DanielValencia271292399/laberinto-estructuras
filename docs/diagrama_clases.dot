digraph G {
  rankdir=TB; nodesep=0.35; ranksep=0.55; splines=spline;
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#475569", arrowsize=0.7];
  subgraph cluster_est { label="estructuras/"; fontname="Helvetica-Bold"; fontsize=10; style="rounded,dashed"; color="#94a3b8";
    Pila [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eff6ff" color="#2563eb"><tr><td bgcolor="#2563eb"><font color="white"><b>Pila</b></font></td></tr><tr><td align="left">- tope: NodoPila<br align="left"/>- _tamano: int<br align="left"/></td></tr><tr><td align="left">+ apilar(dato)<br align="left"/>+ desapilar()<br align="left"/>+ ver_tope()<br align="left"/>+ esta_vacia() / tamano()<br align="left"/>+ vaciar()<br align="left"/></td></tr></table>>];
    Cola [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eff6ff" color="#2563eb"><tr><td bgcolor="#2563eb"><font color="white"><b>Cola</b></font></td></tr><tr><td align="left">- frente, final: NodoCola<br align="left"/>- _tamano: int<br align="left"/></td></tr><tr><td align="left">+ encolar(dato)<br align="left"/>+ desencolar()<br align="left"/>+ ver_frente()<br align="left"/>+ esta_vacia() / tamano()<br align="left"/></td></tr></table>>];
    LC [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eff6ff" color="#2563eb"><tr><td bgcolor="#2563eb"><font color="white"><b>ListaCircular</b></font></td></tr><tr><td align="left">- ultimo, cursor: NodoCircular<br align="left"/></td></tr><tr><td align="left">+ insertar_inicio / final / en_posicion<br align="left"/>+ eliminar(dato) / eliminar_en_posicion<br align="left"/>+ buscar(dato) / obtener(pos)<br align="left"/>+ recorrer(vueltas)<br align="left"/>+ avanzar() / actual()<br align="left"/></td></tr></table>>];
    LD [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eff6ff" color="#2563eb"><tr><td bgcolor="#2563eb"><font color="white"><b>ListaDoble</b></font></td></tr><tr><td align="left">- cabeza, cola: NodoDoble<br align="left"/></td></tr><tr><td align="left">+ insertar_inicio / final / en_posicion<br align="left"/>+ eliminar / eliminar_inicio / final<br align="left"/>+ buscar(dato) / obtener(pos)<br align="left"/>+ recorrer_adelante()<br align="left"/>+ recorrer_atras()<br align="left"/></td></tr></table>>];
    BST [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#eff6ff" color="#2563eb"><tr><td bgcolor="#2563eb"><font color="white"><b>ArbolBST</b></font></td></tr><tr><td align="left">- raiz: NodoArbol<br align="left"/></td></tr><tr><td align="left">+ insertar(clave, valor)<br align="left"/>+ buscar(clave)<br align="left"/>+ eliminar(clave, valor)<br align="left"/>+ inorden / preorden / posorden()<br align="left"/>+ inorden_inverso() / altura()<br align="left"/></td></tr></table>>];
  }
  subgraph cluster_juego { label="juego/"; fontname="Helvetica-Bold"; fontsize=10; style="rounded,dashed"; color="#94a3b8";
    Lab [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>Laberinto</b></font></td></tr><tr><td align="left">- matriz, inicio, salida<br align="left"/></td></tr><tr><td align="left">- _generar_con_pila()<br align="left"/>+ camino_mas_corto(o, d) [BFS]<br align="left"/>+ vecinos(pos) / es_piso(pos)<br align="left"/></td></tr></table>>];
    Ene [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>Enemigo</b></font></td></tr><tr><td align="left">- nombre<br align="left"/>- ruta: ListaCircular<br align="left"/></td></tr><tr><td align="left">+ posicion<br align="left"/>+ mover()<br align="left"/></td></tr></table>>];
    Par [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>Partida</b></font></td></tr><tr><td align="left">- laberinto, jugador, vidas, pasos<br align="left"/>- pila_deshacer: Pila<br align="left"/>- camino: ListaDoble<br align="left"/>- enemigos_espera: Cola<br align="left"/>- enemigos_activos: ListaDoble<br align="left"/></td></tr><tr><td align="left">+ mover(dir) / esperar()<br align="left"/>+ deshacer() / pedir_pista()<br align="left"/>- _procesar_turno()<br align="left"/>+ calcular_puntaje()<br align="left"/></td></tr></table>>];
    Vis [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>VisorRecorrido</b></font></td></tr><tr><td align="left">- camino: ListaDoble<br align="left"/>- nodo, indice<br align="left"/></td></tr><tr><td align="left">+ siguiente() / anterior()<br align="left"/>+ ir_inicio() / ir_final()<br align="left"/></td></tr></table>>];
    Tab [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>TablaPuntajes</b></font></td></tr><tr><td align="left">- arbol: ArbolBST<br align="left"/>- ruta_archivo<br align="left"/></td></tr><tr><td align="left">+ agregar / eliminar / buscar<br align="left"/>+ ranking(n) / recorrido(tipo)<br align="left"/>+ cargar() / guardar()<br align="left"/></td></tr></table>>];
    Reg [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#f0fdf4" color="#16a34a"><tr><td bgcolor="#16a34a"><font color="white"><b>Registro</b></font></td></tr><tr><td align="left">nombre, puntaje, dificultad,<br align="left"/>pasos, fecha<br align="left"/></td></tr></table>>];
  }
  App [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#fff7ed" color="#ea580c"><tr><td bgcolor="#ea580c"><font color="white"><b>AppLaberinto</b> (interfaz/app.py)</font></td></tr><tr><td align="left">- canvas: tk.Canvas<br align="left"/>- partida, tabla, visor<br align="left"/>- botones: ListaDoble de Boton<br align="left"/></td></tr><tr><td align="left">+ dibujar() / ir_a(pantalla)<br align="left"/>+ al_presionar_tecla / al_hacer_clic<br align="left"/></td></tr></table>>];

  App -> Par [label=" usa"]; App -> Tab [label=" usa"]; App -> Vis [label=" usa"];
  Par -> Lab [dir=back, arrowtail=diamond, label=" 1"]; Par -> Ene [label=" 0..*"];
  Par -> Pila; Par -> Cola; Par -> LD;
  Lab -> Pila [style=dashed, label=" genera"]; Lab -> Cola [style=dashed, label=" BFS"];
  Ene -> LC; Vis -> LD; Tab -> BST; Tab -> Reg [label=" 0..*"]; BST -> LD [style=dashed, label=" recorridos"];
}
